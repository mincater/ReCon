# ==========================================
# research-rag Environment Configuration
# Copy this file to .env and fill in values
# ==========================================

# LLM Configuration
LLM_PROVIDER_PRIMARY=groq
LLM_MODEL_PRIMARY=openai/gpt-oss-20b
LLM_PROVIDER_FALLBACK=gemini
LLM_MODEL_FALLBACK=gemini-3.1-flash-lite
GROQ_API_KEY=
GEMINI_API_KEY=

# Search Configuration
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# Vector Database (leave blank for local in-memory/disk Qdrant)
QDRANT_URL=
QDRANT_API_KEY=

# Embedding & Reranker Models
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Chunking Parameters
CHUNK_SIZE=500
CHUNK_OVERLAP=50
